@echo off
chcp 65001 >nul
cd /d "%~dp0"

if "%~1"=="" (
    echo.
    echo =======================================================================
    echo  Перетащите папку с модом на этот файл для автоматического перевода!
    echo  Или просто запустите ProbablyTranslator.exe для графического окна.
    echo =======================================================================
    echo.
    pause
    exit /b
)

echo.
echo =======================================================================
echo  Быстрый перевод мода: "%~nx1"
echo =======================================================================
echo.
set /p TARGET_LANG="Введите язык перевода [по умолчанию ru]: "
if "%TARGET_LANG%"=="" set TARGET_LANG=ru

echo.
echo Запуск перевода на язык [%TARGET_LANG%]...
ProbablyTranslator.exe "%~1" --lang %TARGET_LANG% --auto --install

echo.
echo =======================================================================
echo  Готово! Мод переведен и установлен в папку игры Probably Stolen\Mods.
echo =======================================================================
echo.
pause
